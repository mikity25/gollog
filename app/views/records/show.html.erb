<div class="max-w-3xl mx-auto py-8 px-4">
  <!-- 戻るリンク -->
  <div class="mb-6">
    <%= link_to records_path, class: "inline-flex items-center gap-1.5 text-emerald-700 hover:text-emerald-900 text-sm font-semibold transition" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      カルテ一覧に戻る
    <% end %>
  </div>

  <div class="bg-white rounded-3xl shadow-xl border border-slate-100 overflow-hidden">
    <!-- ヘッダーエリア -->
    <div class="bg-gradient-to-r from-emerald-800 to-emerald-700 text-white p-6 sm:p-8">
      <div class="flex items-center justify-between text-emerald-200 text-sm mb-3 flex-wrap gap-2">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4 opacity-80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <%= @record.played_on.strftime("%Y年%m月%d日") %>
          
          <!-- 休日 / 平日バッジ -->
          <% if @record.played_on.saturday? || @record.played_on.sunday? %>
            <span class="bg-rose-100 text-rose-800 border border-rose-200 px-2.5 py-0.5 rounded-full text-xs font-bold">休日</span>
          <% else %>
            <span class="bg-sky-100 text-sky-800 border border-sky-200 px-2.5 py-0.5 rounded-full text-xs font-bold">平日</span>
          <% end %>

          <% if @record.weather.present? %>
            <span class="bg-emerald-900/70 px-2.5 py-0.5 rounded-full text-xs text-white border border-emerald-600/40">
              <%= @record.weather %>
            </span>
          <% end %>
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-bold tracking-wide">
        <%= @record.golf_course_name %>
      </h1>

      <!-- ヘッダー下部：同伴者・料金・ティー・進行状況 -->
      <div class="flex items-center gap-2.5 mt-3.5 text-xs flex-wrap">
        <% if @record.companion.present? %>
          <span class="bg-white/20 text-white font-semibold px-2.5 py-1 rounded-lg">
            同伴者： <%= @record.companion %>
          </span>
        <% end %>

        <!-- 料金表示 -->
        <% if @record.total_cost.present? %>
          <span class="bg-amber-300 text-slate-900 font-bold px-2.5 py-1 rounded-lg shadow-sm">
            料金： <%= number_to_currency(@record.total_cost, unit: "円", precision: 0, format: "%n%u") %>
          </span>
        <% end %>

        <!-- ティー表示 -->
        <% if @record.tee.present? %>
          <%
            tee_config = case @record.tee
              when "レディース", /赤/ then { class: "bg-rose-500 text-white", dot: "bg-white" }
              when "ショート", /ピンク/ then { class: "bg-pink-400 text-white", dot: "bg-white" }
              when "フロント", /ゴールド/, /緑/ then { class: "bg-amber-400 text-slate-900 font-bold", dot: "bg-slate-900" }
              when "レギュラー", /白/ then { class: "bg-white text-slate-800 font-bold border border-slate-300", dot: "bg-slate-400" }
              when "バック", /青/, /黒/ then { class: "bg-blue-600 text-white", dot: "bg-white" }
              else { class: "bg-emerald-900 text-white", dot: "bg-emerald-300" }
            end
          %>
          <span class="<%= tee_config[:class] %> px-2.5 py-1 rounded-lg text-xs font-semibold shadow-sm flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full <%= tee_config[:dot] %>"></span>
            <span><%= @record.tee %></span>
          </span>
        <% end %>

        <% if @record.pace.present? %>
          <span class="bg-white/10 text-emerald-100 px-2.5 py-1 rounded-lg">進行: <%= @record.pace %></span>
        <% end %>
      </div>
    </div>

    <!-- コンテンツエリア -->
    <div class="p-6 sm:p-8 space-y-6">
      <!-- 満足度 & スコア -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- 総合満足度 -->
        <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-100 flex flex-col justify-between">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-slate-500 font-semibold">総合満足度</span>
            <%
              satisfaction_labels = {
                "star1" => "不満",
                "star2" => "やや不満",
                "star3" => "普通",
                "star4" => "満足",
                "star5" => "大満足"
              }
              satisfaction_text = satisfaction_labels[@record.satisfaction] || @record.satisfaction
              rating_num = @record.satisfaction_before_type_cast.to_i
            %>
            <span class="text-xs text-slate-700 font-bold bg-amber-100 border border-amber-200 px-2.5 py-0.5 rounded-full">
              <%= satisfaction_text %>
            </span>
          </div>
          
          <div class="flex items-center justify-between sm:justify-start sm:gap-2 text-amber-400 py-1">
            <% (1..5).each do |i| %>
              <% if i <= rating_num %>
                <svg class="w-7 h-7 fill-current drop-shadow-sm" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <% else %>
                <svg class="w-7 h-7 text-slate-200 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- スコア -->
        <div class="bg-slate-50 p-4 sm:p-5 rounded-2xl border border-slate-100 flex flex-col justify-between">
          <span class="text-xs text-slate-500 block mb-1 font-semibold">スコア記録</span>
          <% if @record.score_18h.present? %>
            <div class="flex items-baseline gap-2 mt-1">
              <span class="text-slate-900 font-extrabold text-3xl"><%= @record.score_18h %></span>
              <span class="text-xs font-semibold text-slate-600 bg-slate-200 px-2.5 py-0.5 rounded-full">18H ラウンド</span>
            </div>
          <% elsif @record.score_9h.present? %>
            <div>
              <div class="flex items-center gap-2 mt-1">
                <span class="text-slate-900 font-extrabold text-3xl"><%= @record.score_9h %></span>
                <span class="text-xs font-semibold text-emerald-800 bg-emerald-100 px-2.5 py-0.5 rounded-full">
                  ハーフ (9H)
                </span>
              </div>
              <div class="mt-2 text-xs text-slate-600 bg-white p-2 rounded-xl border border-slate-200">
                <span class="font-bold text-emerald-700">18H換算目安スコア： <%= @record.converted_score_18h %></span>
              </div>
            </div>
          <% else %>
            <span class="text-slate-400 text-sm italic mt-1 block">スコア未入力</span>
          <% end %>
        </div>
      </div>

      <!-- ==================== ラウンドの写真 ==================== -->
      <% if @record.images.attached? %>
        <div class="border-t border-slate-100 pt-5">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <% @record.images.each do |image| %>
              <div class="group relative rounded-2xl overflow-hidden border border-slate-200 bg-slate-100 aspect-square shadow-sm hover:shadow-md transition duration-200">
                <%= link_to url_for(image), target: "_blank", rel: "noopener", class: "block w-full h-full" do %>
                  <%= image_tag image, class: "w-full h-full object-cover group-hover:scale-105 transition duration-300", alt: "ラウンド写真" %>
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition duration-200 flex items-center justify-center">
                    <span class="opacity-0 group-hover:opacity-100 text-white text-[11px] font-bold bg-slate-900/60 px-2.5 py-1 rounded-full backdrop-blur-sm transition duration-200">
                      拡大表示 ↗
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- 料金プラン ＆ 食事 -->
      <div class="border-t border-slate-100 pt-5 space-y-3">
        <h2 class="text-sm font-bold text-slate-800">
          料金プラン ＆ 食事
        </h2>

        <% if @record.total_cost.present? || @record.cost_memo.present? || @record.plan_options.present? %>
          <div class="bg-emerald-50/40 border border-emerald-100 rounded-xl p-3 text-xs text-slate-700 space-y-1.5">
            <% if @record.total_cost.present? %>
              <p><strong class="text-emerald-900">料金：</strong> <%= number_to_currency(@record.total_cost, unit: "円", precision: 0, format: "%n%u") %></p>
            <% end %>
            <% if @record.plan_options.present? %>
              <p><strong class="text-emerald-900">プラン：</strong> <%= Array.wrap(@record.plan_options).reject(&:blank?).join(" / ") %></p>
            <% end %>
            <% if @record.cost_memo.present? %>
              <p><strong class="text-emerald-900">プランメモ：</strong> <%= @record.cost_memo %></p>
            <% end %>
          </div>
        <% end %>

        <% if @record.food_rating.present? || @record.food_memo.present? %>
          <div class="bg-amber-50/50 border border-amber-100 rounded-xl p-3 text-xs text-slate-700 space-y-1">
            <p><strong class="text-amber-900">レストラン評価：</strong> <%= @record.food_rating.presence || "未設定" %></p>
            <% if @record.food_memo.present? %>
              <p><strong class="text-amber-900">食事メモ：</strong> <%= @record.food_memo %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- プレースタイル ＆ 系列 -->
      <% if @record.play_style.present? || @record.brand.present? %>
        <div class="border-t border-slate-100 pt-5 space-y-2">
          <h2 class="text-sm font-bold text-slate-800">
            プレースタイル ＆ 系列
          </h2>
          <div class="flex items-center gap-2 text-xs text-slate-700 flex-wrap">
            <% if @record.play_style.present? %>
              <span class="bg-slate-100 px-3 py-1 rounded-lg">スタイル： <strong><%= @record.play_style %></strong></span>
            <% end %>
            <% if @record.brand.present? %>
              <span class="bg-slate-100 px-3 py-1 rounded-lg">系列・ブランド： <strong><%= @record.brand %></strong></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- コースの特徴・難易度 -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-800 mb-3">
          コースの特徴・難易度
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center mb-3">
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">総合難易度</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.difficulty.presence || "未設定" %></span>
          </div>
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">コース広さ</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.course_width.presence || "未設定" %></span>
          </div>
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">OB出やすさ</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.ob_risk.presence || "未設定" %></span>
          </div>
          <div class="bg-emerald-50/50 p-2.5 rounded-xl border border-emerald-100/60">
            <span class="text-[11px] text-slate-500 block">フェアウェイ</span>
            <span class="text-xs font-bold text-emerald-900"><%= @record.fairway.presence || "未設定" %></span>
          </div>
        </div>

        <div class="bg-slate-50 p-3.5 rounded-xl space-y-2 text-xs text-slate-700">
          <% if @record.bunker_difficulty.present? %>
            <p><strong class="text-slate-900">バンカー：</strong> <%= @record.bunker_difficulty %></p>
          <% end %>
          <% if @record.hazard.present? %>
            <p><strong class="text-slate-900">池・谷・崖：</strong> <%= @record.hazard %></p>
          <% end %>
          <% if @record.green_features.present? %>
            <p><strong class="text-slate-900">グリーン傾向：</strong> <%= Array.wrap(@record.green_features).reject(&:blank?).join(" / ") %></p>
          <% end %>
          <% if @record.green_memo.present? %>
            <p><strong class="text-slate-900">グリーン補足：</strong> <%= @record.green_memo %></p>
          <% end %>
        </div>
      </div>

      <!-- 設備 -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-800 mb-3">
          設備
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center mb-3">
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">コース内トイレ</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.toilet_rating.presence || "未設定" %></span>
          </div>
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">カート</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.cart_type.presence || "未設定" %></span>
          </div>
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">コースメンテ</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.maintenance.presence || "未設定" %></span>
          </div>
          <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
            <span class="text-[11px] text-slate-500 block">スタッフ接客</span>
            <span class="text-xs font-bold text-slate-800"><%= @record.service.presence || "未設定" %></span>
          </div>
        </div>

        <div class="space-y-2 text-xs text-slate-700">
          <% if @record.driving_range.present? %>
            <p class="bg-slate-50 p-2.5 rounded-xl border border-slate-100"><strong class="text-slate-900">練習場：</strong> <%= Array.wrap(@record.driving_range).reject(&:blank?).join(" / ") %></p>
          <% end %>
          <% if @record.shop_memo.present? %>
            <p class="bg-slate-50 p-2.5 rounded-xl border border-slate-100"><strong class="text-slate-900">売店・自販機：</strong> <%= @record.shop_memo %></p>
          <% end %>
        </div>
      </div>

      <!-- お風呂・アメニティ -->
      <% if @record.bath_rating.present? || @record.bath_features.present? || @record.bath_memo.present? %>
        <div class="border-t border-slate-100 pt-5">
          <h2 class="text-sm font-bold text-slate-800 mb-3">
            お風呂・アメニティ
          </h2>

          <!-- 総合評価（総合難易度と同じデザインのカード） -->
          <% if @record.bath_rating.present? %>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center mb-3">
              <div class="bg-sky-50/60 p-2.5 rounded-xl border border-sky-100">
                <span class="text-[11px] text-slate-500 block">総合評価</span>
                <span class="text-xs font-bold text-sky-900"><%= @record.bath_rating %></span>
              </div>
            </div>
          <% end %>

          <!-- 設備・特徴 ＆ メモ -->
          <% if @record.bath_features.present? || @record.bath_memo.present? %>
            <div class="bg-slate-50 p-3.5 rounded-xl space-y-2 text-xs text-slate-700">
              <% if @record.bath_features.present? %>
                <%
                  formatted_baths = Array.wrap(@record.bath_features).reject(&:blank?).map do |item|
                    case item
                    when "高級ドライヤー", "高級ドライヤー(ReFa等)あり" then "高級ドライヤー(ReFa等)あり"
                    when "温泉あり" then "温泉・露天風呂あり"
                    when "サウナあり" then "サウナ・水風呂あり"
                    else item
                    end
                  end
                %>
                <p><strong class="text-slate-900">設備・特徴：</strong> <%= formatted_baths.join(" / ") %></p>
              <% end %>
              <% if @record.bath_memo.present? %>
                <p><strong class="text-slate-900">お風呂メモ：</strong> <%= @record.bath_memo %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- メモ・振り返り -->
      <div class="border-t border-slate-100 pt-5">
        <h2 class="text-sm font-bold text-slate-800 mb-2">メモ・振り返り</h2>
        <% if @record.memo.present? %>
          <div class="bg-amber-50/60 border border-amber-100 rounded-2xl p-4 text-slate-700 leading-relaxed text-sm whitespace-pre-wrap"><%= @record.memo.strip %></div>
        <% else %>
          <div class="bg-amber-50/60 border border-amber-100 rounded-2xl p-4 text-slate-400 italic text-sm">メモはありません</div>
        <% end %>
      </div>

      <!-- アクションボタン枠（一覧へ戻る・編集・削除） -->
      <div class="border-t border-slate-100 pt-6 flex items-center justify-between gap-2 sm:gap-3">
        <%= link_to records_path, class: "inline-flex items-center gap-1 sm:gap-1.5 px-3 sm:px-4 py-2 sm:py-2.5 text-xs sm:text-sm text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl transition font-medium whitespace-nowrap shrink-0" do %>
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span class="hidden sm:inline">一覧へ戻る</span>
          <span class="sm:hidden">一覧</span>
        <% end %>

        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <%= link_to edit_record_path(@record), class: "inline-flex items-center gap-1 sm:gap-1.5 px-3 sm:px-4 py-2 sm:py-2.5 text-xs sm:text-sm font-bold text-white bg-emerald-700 hover:bg-emerald-800 rounded-xl shadow-sm transition whitespace-nowrap" do %>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            <span class="hidden sm:inline">編集する</span>
            <span class="sm:hidden">編集</span>
          <% end %>

          <%= link_to record_path(@record),
                      data: { turbo_method: :delete, turbo_confirm: "本当にこのカルテを削除しますか？" },
                      class: "inline-flex items-center gap-1 sm:gap-1.5 px-3 sm:px-4 py-2 sm:py-2.5 text-xs sm:text-sm font-bold text-red-600 bg-red-50 hover:bg-red-100 rounded-xl border border-red-200 transition cursor-pointer whitespace-nowrap" do %>
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            <span class="hidden sm:inline">削除する</span>
            <span class="sm:hidden">削除</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>