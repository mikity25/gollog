<div class="max-w-4xl mx-auto py-8 px-4">
  <!-- ヘッダーエリア -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 mb-1">
        <svg class="w-7 h-7 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
          <path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
          <path d="M3 6l0 13" />
          <path d="M12 6l0 13" />
          <path d="M21 6l0 13" />
        </svg>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-800 tracking-tight">ゴルフカルテ一覧</h1>
      </div>
      <p class="text-xs sm:text-sm text-slate-500">
        これまでのラウンド・コースカルテの記録一覧です（<%= @records.count %>件）
      </p>
    </div>
    <div>
      <%= link_to new_record_path, class: "inline-flex items-center gap-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 px-5 rounded-xl shadow-sm hover:shadow-md transition text-sm cursor-pointer whitespace-nowrap" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        新しいカルテを書く
      <% end %>
    </div>
  </div>

  <!-- ==================== 検索 ＆ ソート 操作エリア ==================== -->
  <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/80 shadow-xs mb-6">
    <%= form_with url: records_path, method: :get, local: true, class: "space-y-3" do |f| %>
      <div class="flex flex-col sm:flex-row gap-3">
        <!-- 検索バー -->
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <%= f.text_field :keyword, 
                value: params[:keyword], 
                placeholder: "ゴルフ場名・同伴者・メモで検索", 
                class: "w-full pl-10 pr-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition placeholder:text-slate-400" %>
        </div>

        <!-- ソート選択プルダウン -->
        <div class="w-full sm:w-56 shrink-0">
          <%= f.select :sort, 
                [
                  ["プレー日（新しい順）", "played_on_desc"],
                  ["プレー日（古い順）", "played_on_asc"],
                  ["総合満足度（高い順）", "satisfaction_desc"],
                  ["総合満足度（低い順）", "satisfaction_asc"],
                  ["スコア（良い順）", "score_asc"],
                  ["料金（安い順）", "cost_asc"],
                  ["料金（高い順）", "cost_desc"]
                ], 
                { selected: params[:sort] || "played_on_desc" }, 
                class: "w-full py-2.5 px-3 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition cursor-pointer" %>
        </div>

        <!-- ボタンエリア -->
        <div class="flex items-center gap-2">
          <%= f.submit "検索", class: "flex-1 sm:flex-none bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-2.5 px-6 rounded-xl transition text-sm cursor-pointer shadow-xs whitespace-nowrap" %>
          <% if params[:keyword].present? || (params[:sort].present? && params[:sort] != "played_on_desc") %>
            <%= link_to "クリア", records_path, class: "py-2.5 px-3.5 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition text-xs font-semibold whitespace-nowrap" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- 除外条件のアナウンスバナー -->
    <% if params[:sort] == "score_asc" %>
      <div class="mt-3 pt-3 border-t border-slate-100 flex items-center gap-2 text-xs text-amber-800 bg-amber-50/80 px-3 py-2 rounded-lg">
        <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12.01" y2="16"></line><line x1="12" y1="8" x2="12" y2="12"></line></svg>
        <span>スコアが入力されているカルテのみを良い順に並べて表示しています</span>
      </div>
    <% elsif %w[cost_asc cost_desc].include?(params[:sort]) %>
      <div class="mt-3 pt-3 border-t border-slate-100 flex items-center gap-2 text-xs text-amber-800 bg-amber-50/80 px-3 py-2 rounded-lg">
        <svg class="w-4 h-4 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12.01" y2="16"></line><line x1="12" y1="8" x2="12" y2="12"></line></svg>
        <span>総額料金が入力されているカルテのみを並べて表示しています</span>
      </div>
    <% end %>
  </div>

  <!-- カルテ一覧リスト -->
  <% if @records.present? %>
    <div class="grid gap-4">
      <% @records.each do |record| %>
        <%= link_to record_path(record), class: "group block bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/80 shadow-xs hover:shadow-md hover:border-emerald-500 transition-all duration-200 relative overflow-hidden" do %>
          <!-- カード左端のホバーアクセントライン -->
          <div class="absolute inset-y-0 left-0 w-1.5 bg-transparent group-hover:bg-emerald-600 transition-colors"></div>

          <!-- 上段: 日付 ＆ バッジ群 ＆ 満足度 -->
          <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
            <!-- 日付 ＆ 各種タグ -->
            <div class="flex items-center gap-2 flex-wrap">
              <span class="inline-flex items-center gap-1 text-xs text-slate-700 font-bold whitespace-nowrap">
                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <%= record.played_on.strftime("%Y/%m/%d") %>
              </span>

              <!-- 休日 / 平日バッジ -->
              <% if record.played_on.saturday? || record.played_on.sunday? %>
                <span class="bg-rose-50 text-rose-700 border border-rose-200/70 text-[11px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                  休日
                </span>
              <% else %>
                <span class="bg-sky-50 text-sky-700 border border-sky-200/70 text-[11px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap">
                  平日
                </span>
              <% end %>

              <!-- 天気 -->
              <% if record.weather.present? %>
                <span class="bg-slate-100 text-slate-600 text-[11px] font-medium px-2 py-0.5 rounded-full whitespace-nowrap">
                  <%= record.weather %>
                </span>
              <% end %>

              <!-- ティー（青/黒をブルー系に統一） -->
              <% if record.tee.present? %>
                <%
                  tee_config = case record.tee
                    when "レディース", /赤/ then { class: "bg-rose-500 text-white", dot: "bg-white" }
                    when "ショート", /ピンク/ then { class: "bg-pink-400 text-white", dot: "bg-white" }
                    when "フロント", /ゴールド/, /緑/ then { class: "bg-amber-400 text-slate-900 font-bold", dot: "bg-slate-900" }
                    when "レギュラー", /白/ then { class: "bg-white text-slate-800 font-bold border border-slate-300", dot: "bg-slate-400" }
                    when "バック", /青/, /黒/ then { class: "bg-blue-600 text-white", dot: "bg-white" }
                    else { class: "bg-emerald-900 text-white", dot: "bg-emerald-300" }
                  end
                %>
                <span class="<%= tee_config[:class] %> text-[11px] font-semibold px-2.5 py-0.5 rounded-full inline-flex items-center gap-1.5 shadow-xs whitespace-nowrap">
                  <span class="w-1.5 h-1.5 rounded-full <%= tee_config[:dot] %>"></span>
                  <span><%= record.tee %></span>
                </span>
              <% end %>

              <!-- 同伴者 -->
              <% if record.companion.present? %>
                <span class="bg-slate-50 text-slate-600 text-[11px] font-medium px-2 py-0.5 rounded-full border border-slate-200/60 hidden sm:inline-block whitespace-nowrap">
                  同伴： <%= record.companion %>
                </span>
              <% end %>

              <!-- 写真ありバッジ -->
              <% if record.images.attached? %>
                <span class="bg-emerald-50 text-emerald-800 border border-emerald-200/70 text-[11px] font-semibold px-2 py-0.5 rounded-full inline-flex items-center gap-1 whitespace-nowrap">
                  <span>📷</span>
                  <span><%= record.images.size %>枚</span>
                </span>
              <% end %>
            </div>

            <!-- 満足度（星とバッジ） -->
            <%
              satisfaction_labels = {
                "star1" => "不満",
                "star2" => "やや不満",
                "star3" => "普通",
                "star4" => "満足",
                "star5" => "大満足"
              }
              satisfaction_text = satisfaction_labels[record.satisfaction] || record.satisfaction
              rating_num = record.satisfaction_before_type_cast.to_i
            %>
            <div class="flex items-center gap-2 whitespace-nowrap shrink-0">
              <div class="flex items-center gap-1 text-amber-400">
                <% (1..5).each do |i| %>
                  <% if i <= rating_num %>
                    <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current drop-shadow-xs" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  <% else %>
                    <svg class="w-5 h-5 sm:w-6 sm:h-6 text-slate-200 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  <% end %>
                <% end %>
              </div>
              <span class="text-slate-800 font-extrabold bg-amber-100/80 border border-amber-200 px-2.5 py-0.5 rounded-full text-xs sm:text-sm">
                <%= satisfaction_text %>
              </span>
            </div>
          </div>

          <!-- 中段: ゴルフ場名 ＆ メモ抜粋 -->
          <div class="mb-3">
            <h2 class="text-lg sm:text-xl font-bold text-slate-800 group-hover:text-emerald-700 transition tracking-tight">
              <%= record.golf_course_name %>
            </h2>
            <% if record.memo.present? %>
              <p class="text-xs text-slate-500 line-clamp-1 mt-1 font-normal">
                <%= record.memo %>
              </p>
            <% end %>
          </div>

          <!-- 下段: スコア ＆ 料金 ＆ 詳細を見る矢印（常に右端固定） -->
          <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs text-slate-600 flex-wrap gap-2">
            <div class="flex items-center gap-2 sm:gap-4 flex-wrap">
              <!-- スコア表示 -->
              <% if record.score_18h.present? %>
                <div class="flex items-baseline gap-1 whitespace-nowrap">
                  <span class="text-slate-400 text-xs font-semibold">18H：</span>
                  <span class="text-xl font-extrabold text-slate-900 tracking-tight"><%= record.score_18h %></span>
                </div>
              <% elsif record.score_9h.present? %>
                <div class="flex items-center gap-1.5 flex-wrap">
                  <div class="flex items-baseline gap-1 whitespace-nowrap">
                    <span class="text-slate-400 text-xs font-semibold">9H：</span>
                    <span class="text-xl font-extrabold text-slate-900 tracking-tight"><%= record.score_9h %></span>
                  </div>
                  <span class="text-[11px] text-emerald-800 bg-emerald-50 border border-emerald-200/60 px-2 py-0.5 rounded-md font-semibold whitespace-nowrap">
                    18H換算： <%= record.converted_score_18h %>
                  </span>
                </div>
              <% else %>
                <span class="text-slate-400 italic text-xs whitespace-nowrap">スコア未入力</span>
              <% end %>

              <!-- 料金表示 -->
              <% if record.total_cost.present? %>
                <span class="text-slate-700 font-bold bg-slate-50 border border-slate-200/70 px-2.5 py-1 rounded-lg text-xs whitespace-nowrap">
                  料金： <%= number_to_currency(record.total_cost, unit: "円", precision: 0, format: "%n%u") %>
                </span>
              <% end %>

              <!-- ブランド -->
              <% if record.brand.present? %>
                <span class="text-slate-500 text-xs hidden sm:inline-block whitespace-nowrap">
                  <%= record.brand %>
                </span>
              <% end %>
            </div>

            <!-- 詳細リンク案内（ml-autoで右端固定 ＆ 改行防止） -->
            <div class="inline-flex items-center gap-1 text-emerald-700 font-bold group-hover:text-emerald-800 transition ml-auto shrink-0 whitespace-nowrap">
              <span>詳細を見る</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <!-- カルテが0件のとき（検索時と未登録時で分岐） -->
    <div class="text-center py-16 bg-white rounded-3xl shadow-sm border border-dashed border-slate-200 p-6">
      <div class="w-12 h-12 mx-auto mb-3 text-slate-300 flex items-center justify-center">
        <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      </div>

      <% if params[:keyword].present? || params[:sort].present? %>
        <!-- 検索結果が0件のとき -->
        <p class="text-slate-700 font-bold mb-1 text-base">該当するゴルフカルテが見つかりませんでした</p>
        <p class="text-xs text-slate-400 mb-6">検索キーワードや並び替えの条件を変更してお試しください</p>
        <%= link_to "すべてのカルテを表示する", records_path, class: "inline-block bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2.5 px-5 rounded-xl transition text-sm" %>
      <% else %>
        <!-- カルテ自体が1件もないとき -->
        <p class="text-slate-600 font-bold mb-1">まだ登録されたゴルフカルテがありません</p>
        <p class="text-xs text-slate-400 mb-6">最初のラウンド記録をつけてみましょう！</p>
        <%= link_to new_record_path, class: "inline-block bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 px-6 rounded-xl transition shadow-sm" do %>
          最初のカルテを登録してみる
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>