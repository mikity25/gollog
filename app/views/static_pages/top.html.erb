<!-- メインヒーローセクション -->
<section style="background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%); text-align: center; padding: clamp(48px, 8vw, 84px) 20px 48px; border-bottom: 1px solid #e2e8f0;">
  <div style="max-width: 760px; margin: 0 auto;">

    <!-- サブキャッチ 1 -->
    <p style="font-size: clamp(13px, 3.2vw, 15px); color: #2d6a4f; font-weight: 700; letter-spacing: 0.08em; margin: 0 0 10px 0;">
      自分視点の本音メモで、次のコース選びを最適化
    </p>

    <!-- サブキャッチ 2 -->
    <p style="font-size: clamp(16px, 4vw, 22px); color: #334155; font-weight: 700; margin: 0 0 20px 0; letter-spacing: 0.02em;">
      自分専用 ゴルフ場カルテ
    </p>

    <!-- メインロゴ（gollogの文字を完全センター配置 ＆ アイコンを左隣に配置） -->
    <div class="relative inline-block mb-7 text-center">
      <!-- 左隣に寄り添うアイコン（絶対配置で文字の左側に配置） -->
      <svg class="absolute right-full top-1/2 -translate-y-1/2 mr-2 w-10 h-10 sm:w-14 sm:h-14 text-emerald-800 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 18v-15l7 4l-7 4" />
        <path d="M9 17.67c-.62 .36 -1 .82 -1 1.33c0 1.1 1.8 2 4 2s4 -.9 4 -2c0 -.5 -.38 -.97 -1 -1.33" />
      </svg>
      <!-- 完全中央に配置されるブランド名テキスト -->
      <h1 class="font-['Josefin_Sans',sans-serif] text-5xl sm:text-7xl font-bold text-emerald-800 tracking-wider leading-none m-0">
        gollog
      </h1>
    </div>

    <!-- コンセプトの補足 -->
    <p style="font-size: clamp(13px, 3.2vw, 14px); color: #64748b; line-height: 1.7; max-width: 540px; margin: 0 auto 32px auto;">
      他人の口コミではなく、自分が感じたリアルな難易度・食事・設備をボタンタップでサクッと蓄積。誰にも見られない完全プライベートな記録帳です。
    </p>

    <!-- アクションボタン -->
    <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
      <% if user_signed_in? %>
        <%= link_to "カルテ一覧を見る", records_path, style: "background-color: #2d6a4f; color: #ffffff; padding: 14px 32px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; box-shadow: 0 4px 12px rgba(45, 106, 79, 0.25); min-width: 180px;" %>
        <%= link_to "+ 新規カルテ作成", new_record_path, style: "background-color: #ffffff; color: #2d6a4f; border: 2px solid #2d6a4f; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; min-width: 180px;" %>
      <% else %>
        <!-- ワンクリックゲストログインボタン -->
        <%= button_to guest_sign_in_path, method: :post, style: "background-color: #d97706; color: #ffffff; border: none; padding: 14px 28px; border-radius: 8px; font-size: 15px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25); min-width: 200px; display: inline-flex; align-items: center; justify-content: center;" do %>
          <span style="margin-right: 6px;"></span> おためしゲストログイン
        <% end %>
        <%= link_to "無料ではじめる（新規登録）", new_user_registration_path, style: "background-color: #2d6a4f; color: #ffffff; padding: 14px 32px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; box-shadow: 0 4px 12px rgba(45, 106, 79, 0.25); min-width: 200px;" %>
        <%= link_to "ログイン", new_user_session_path, style: "background-color: #ffffff; color: #2d6a4f; border: 2px solid #2d6a4f; padding: 12px 28px; border-radius: 8px; text-decoration: none; font-size: 15px; font-weight: bold; display: inline-block; min-width: 120px;" %>
      <% end %>
    </div>

  </div>
</section>

<!-- サービスの特徴セクション -->
<section style="max-width: 980px; margin: 48px auto 64px; padding: 0 20px;">
  <div style="text-align: center; margin-bottom: 36px;">
    <h2 style="font-size: clamp(20px, 4.5vw, 24px); font-weight: 700; color: #1e293b; margin: 0 0 6px 0;">
      <span style="font-family: 'Josefin Sans', sans-serif; color: #2d6a4f;">gollog</span> が選ばれる3つの理由
    </h2>
    <p style="font-size: 13px; color: #64748b; margin: 0;">シンプルだから、ラウンド直後でも迷わず続く</p>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">

    <!-- 特徴 1: ボタンタップでサクッと記録 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 26px 22px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04); display: flex; flex-direction: column;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
        <span style="font-family: 'Josefin Sans', sans-serif; font-size: 12px; font-weight: 700; color: #2d6a4f; background: #e8f5e9; padding: 4px 10px; border-radius: 4px;">01</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2d6a4f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"></path>
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
        </svg>
      </div>
      <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">ボタンタップで即座に記録</h3>
      <p style="font-size: 13px; color: #64748b; line-height: 1.65; margin: 0;">
        疲れたラウンド後でも、満足度・難易度・食事などをボタン中心で記録。長文入力をしなくても自分基準のカルテが完成します。
      </p>
    </div>

    <!-- 特徴 2: 本音メモ＆非公開 -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 26px 22px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04); display: flex; flex-direction: column;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
        <span style="font-family: 'Josefin Sans', sans-serif; font-size: 12px; font-weight: 700; color: #2d6a4f; background: #e8f5e9; padding: 4px 10px; border-radius: 4px;">02</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2d6a4f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">他人の目を気にしない本音メモ</h3>
      <p style="font-size: 13px; color: #64748b; line-height: 1.65; margin: 0;">
        公開前提の口コミサイトでは書けない「設備の印象」や「注意点」も自由にメモ。自分だけの非公開カルテだから安心です。
      </p>
    </div>

    <!-- 特徴 3: 次のコース選びを迷わない -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 26px 22px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04); display: flex; flex-direction: column;">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
        <span style="font-family: 'Josefin Sans', sans-serif; font-size: 12px; font-weight: 700; color: #2d6a4f; background: #e8f5e9; padding: 4px 10px; border-radius: 4px;">03</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2d6a4f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
      <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px 0;">次のコース選び・リベンジに直結</h3>
      <p style="font-size: 13px; color: #64748b; line-height: 1.65; margin: 0;">
        「前回の印象はどうだったか」「スコアはどうだったか」をすぐに見返し、納得感のあるコース選定や友人への推薦に活かせます。
      </p>
    </div>

  </div>
</section>